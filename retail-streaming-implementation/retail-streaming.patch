+name: Deploy retail streaming
+on:
+  workflow_dispatch:
+    inputs:
+      target:
+        type: choice
+        options: [dev, test, prod]
+        default: dev
+        required: true
+permissions:
+  contents: read
+concurrency:
+  group: retail-deploy-${{ inputs.target }}
+  cancel-in-progress: false
+jobs:
+  deploy:
+    runs-on: ubuntu-latest
+    environment: retail-${{ inputs.target }}
+    defaults:
+      run:
+        working-directory: projects/databricks-streaming-pipeline
+    env:
+      DATABRICKS_HOST: ${{ secrets.DATABRICKS_HOST }}
+      DATABRICKS_CLIENT_ID: ${{ secrets.DATABRICKS_CLIENT_ID }}
+      DATABRICKS_CLIENT_SECRET: ${{ secrets.DATABRICKS_CLIENT_SECRET }}
+      DATABRICKS_AUTH_TYPE: oauth-m2m
+      BUNDLE_VAR_service_principal: ${{ secrets.DATABRICKS_CLIENT_ID }}
+      DEPLOY_TARGET: ${{ inputs.target }}
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.11'
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+      - uses: databricks/setup-cli@main
+      - run: python -m pip install -e '.[test]'
+      - run: python -m ruff check .
+      - run: python -m pytest -q
+      - run: databricks bundle validate -t "$DEPLOY_TARGET"
+      - run: databricks bundle deploy -t "$DEPLOY_TARGET"
